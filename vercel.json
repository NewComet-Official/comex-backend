{
  "version": 2,
  "routes": [
    {
      "source": "/",
      "headers": { "Location": "/home" },
      "status": 301
    },
    { "source": "/widget.js",
    "dest": "/public/widget.js"
    },
    {
      "source": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "source": "/dashboard/testing/(.*)",
      "dest": "/index.html"
    },
    {
      "source": "/dashboard/(.*)",
      "dest": "/index.html"
    },
    {
      "source": "/recycle-bin",
      "dest": "/index.html"
    },
    {
      "source": "/(dashboard|new-deployment|third-party-integrations|analytics|reports|human-dashboard|employee-dashboard|settings|home)",
      "dest": "/index.html"
    },
    {
      "source": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
